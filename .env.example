# Postgres connection string. Locally: `docker compose up -d` then use the value below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/allin1"
# Long random string used to sign login sessions: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"
# Claude API key for food text/photo analysis (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
# Optional: email verification codes at sign-up (https://resend.com). Leave empty to skip verification.
RESEND_API_KEY=""
# Sender address. Must be on a domain verified in Resend; onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM="ALLIN1 <onboarding@resend.dev>"
