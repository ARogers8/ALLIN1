# Postgres connection string. Locally: `docker compose up -d` then use the value below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/allin1"
# Long random string used to sign login sessions: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"
# Claude API key for food text/photo analysis (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
